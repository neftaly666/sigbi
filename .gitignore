# ---- Secretos y entorno ----
.env
.env.*
!.env.example
*.pem
*.key
application-local.yaml
application-local.properties

# ---- Backend (Maven / Java) ----
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
hs_err_pid*
replay_pid*

# ---- Frontend (Angular / Node) ----
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
npm-debug.log*
yarn-error.log*

# ---- IDE ----
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
nbproject/private/

# ---- Restos de herramientas ----
__pycache__/
*.pyc

# ---- Sistema operativo ----
.DS_Store
Thumbs.db

# ---- Documentación ----
# Los comprimidos son material de apoyo del curso, no entregables del proyecto.
documentacion/*.zip
documentacion/*.xlsx

# Los AN*.docx y los EST*.docx SI entran: son los documentos de SIGBI generados desde sus
# .md con documentacion/herramientas/generar-docx.sh. La fuente sigue siendo el .md; el
# .docx es la copia entregable en Word.
