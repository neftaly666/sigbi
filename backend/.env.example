# Plantilla de variables de entorno de SIGBI.
#
#   cp .env.example .env     y rellena los valores reales EN EL .env
#
# Este fichero se versiona y NO debe contener ningun valor real: es solo la
# lista de lo que hay que definir. El .env queda fuera de git (.gitignore).
#
# Para cargarlas en la sesion actual:
#   set -a && . ./.env && set +a

# ---- Base de datos (obligatorias) --------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> Session pooler
#
# OJO a las dos diferencias del pooler frente a la conexion directa:
#   1. el host es aws-<n>-<region>.pooler.supabase.com, no db.<ref>.supabase.co
#   2. el usuario lleva la referencia del proyecto: postgres.<ref>, no postgres
#
# Puerto 5432 = session pooler (correcto para Hibernate).
# Puerto 6543 = transaction pooler: NO usar, rompe las sentencias preparadas.
# La cadena tiene que empezar por jdbc: aunque Supabase la muestre sin el prefijo.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<referencia-del-proyecto>
DB_PASSWORD=

# ---- Servidor (obligatorias) -------------------------------------------------
# SERVER_PORT vale 80 por defecto en application.yaml y el frontend espera 8080.
SERVER_PORT=8080
FRONT_URL=http://localhost:4200

# ---- Autenticacion -----------------------------------------------------------
# SUPABASE_ISSUER_URI y SUPABASE_URL no tienen valor por defecto: si no se
# definen, el arranque falla aunque no vayas a usar autenticacion (AN110 sección 4.2).
SUPABASE_ISSUER_URI=https://<referencia-del-proyecto>.supabase.co/auth/v1
SUPABASE_URL=https://<referencia-del-proyecto>.supabase.co
SUPABASE_ANON_KEY=
# Clave de servicio: salta el RLS. NUNCA al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# AUTH_MODE tiene que decir lo mismo que environment.AUTH_MODE del frontend,
# o todas las peticiones responden 401 tras un login correcto.
AUTH_MODE=bearer

# ---- Inteligencia artificial (solo para el asistente) ------------------------
OPENAI_API_KEY=

# PA-02: true por defecto. false abre /v1/** sin token, util en desarrollo
# y para que el evaluador pueda probar la API sin crear un usuario en Supabase.
AUTH_ENABLED=true
